# Copy to backend/.env and adjust. Every variable is optional; the defaults
# run the application against the bundled CSV seed data.

# -- Data source -------------------------------------------------------------
# "csv" for development, "sql" for a real database.
SERVIZON_DATA_SOURCE=csv

# Any SQLAlchemy URL. Used only when DATA_SOURCE=sql.
#   SQL Server : mssql+pyodbc://user:pw@host/db?driver=ODBC+Driver+18+for+SQL+Server
#   PostgreSQL : postgresql+psycopg://user:pw@host/db
#   Oracle     : oracle+oracledb://user:pw@host:1521/?service_name=svc
# SERVIZON_DATABASE_URL=sqlite:///./data/servizon.db

# Saved scenarios. Deliberately separate from the read source, so pointing the
# application at a production database can never write to it.
# SERVIZON_SCENARIOS_DATABASE_URL=sqlite:///./data/scenarios.db

# -- Background refresh ------------------------------------------------------
SERVIZON_REFRESH_MINUTES=3
SERVIZON_REFRESH_ON_STARTUP=true

# -- HTTP --------------------------------------------------------------------
SERVIZON_HOST=127.0.0.1
SERVIZON_PORT=8000

# -- Logging -----------------------------------------------------------------
# Local rotating file only. Nothing is sent off the machine.
SERVIZON_LOG_LEVEL=INFO
